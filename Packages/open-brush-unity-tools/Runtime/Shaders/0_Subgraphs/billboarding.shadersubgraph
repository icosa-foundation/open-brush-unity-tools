    "m_FunctionBody": "    float3 forward = normalize(CameraPosition - QuadCenter);\r\n    float3 up = float3(0, 1, 0);\r\n    float3 right = normalize(cross(up, forward));\r\n    up = cross(forward, right);\r\n\r\n    float2 offsets[4] = {\r\n        float2(-0.5, -0.5),\r\n        float2( 0.5, -0.5),\r\n        float2(-0.5,  0.5),\r\n        float2( 0.5,  0.5)\r\n    };\r\n\r\n    int localID = (int)fmod(VertexID, 4);\r\n    float2 offset = offsets[localID] * QuadSize;\r\n\r\n    PositionOffset = right * offset.x + up * offset.y;"
}

